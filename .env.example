# QWEEN VR Store — environment variables (§27).
# Copy to .env.local for local development. Never commit real secrets.
# Only NEXT_PUBLIC_* vars are exposed to the browser; keep true secrets server-side.

# Analytics id for a production provider (wired via lib/vr/analytics.ts).
NEXT_PUBLIC_ANALYTICS_ID=

# Base URL of the eventual QWEEN product API (§12). Unused in V1 (static data).
NEXT_PUBLIC_API_URL=
